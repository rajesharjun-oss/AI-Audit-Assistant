# Direct OpenAI API setup for AI-assisted review.
# Copy to .env locally if you use a dotenv loader, or set these variables in your shell/deployment platform.
# Never put a real API key in Git.

OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_STYLE=responses
OPENAI_STRUCTURED_OUTPUTS=1

# Defaults can be overridden per review mode.
OPENAI_QUICK_REVIEW_MODEL=gpt-5-mini
OPENAI_STANDARD_REVIEW_MODEL=gpt-5.1
OPENAI_DEEP_REVIEW_MODEL=gpt-5.1
OPENAI_SAFE_FALLBACK_MODEL=gpt-4o-mini
OPENAI_QUICK_STRUCTURED_OUTPUTS=0
OPENAI_QUICK_REVIEW_OUTPUT_TOKENS=1600
# Automatic AI review safety limits. Keep these modest so deterministic exports are not delayed.
OPENAI_MAX_ATTEMPTS=1
OPENAI_RETRY_BACKOFF_SECONDS=5
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_REQUEST_LOCK_TIMEOUT_SECONDS=30
OPENAI_AI_PIPELINE_LOCK_TIMEOUT_SECONDS=30
OPENAI_MODEL_FALLBACK_LIMIT=2